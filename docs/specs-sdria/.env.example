# Copie este arquivo para .env e preencha com valores reais.
# Nunca commitar o arquivo .env real no repositório.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Modelo de IA (classe Haiku 4.5, conforme docs/ARCHITECTURE.md)
AI_MODEL_API_KEY=
AI_MODEL_NAME=

# WhatsApp (API oficial Meta)
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# E-mail transacional (ex: Amazon SES, SendGrid, Postmark)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# SMS (ex: Twilio, Zenvia)
SMS_PROVIDER_API_KEY=
SMS_FROM_NUMBER=

# Google Calendar
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Regras de timing (ver .agents/agents.md — Persona: Nina Runtime)
REGRA_SILENCIO_HORAS=6
REGRA_RECUPERACAO_ABANDONO_MINUTOS=15
