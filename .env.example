# Porta do Servidor
PORT=3333
NODE_ENV=development

# Supabase (Banco de Dados / Memória)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anthropic (Claude Haiku 3.5 / 4.5)
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-3-5-haiku-latest

# WhatsApp (Meta Cloud API Oficial)
META_WHATSAPP_TOKEN=your-meta-access-token
META_PHONE_NUMBER_ID=your-phone-number-id
META_VERIFY_TOKEN=your-webhook-verification-token

# ElevenLabs (Síntese de Voz)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# E-mail e SMS
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Nina | SDR <nina@empresa.com.br>"
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Regras de Negócio (Minutos e Horas)
FORM_ABANDONMENT_MINUTES=15
SILENCE_RADAR_HOURS=6
