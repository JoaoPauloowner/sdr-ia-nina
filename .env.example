# Porta do Servidor e Ambiente
PORT=3333
NODE_ENV=development

# Segurança & Autenticação do Dashboard Operacional
# Defina uma chave para proteger as métricas e o painel operacional da Nina
ADMIN_API_KEY=nina_admin_super_secret_key_2026
DASHBOARD_PASSWORD=sua_senha_do_painel_aqui

# Supabase (Banco de Dados / Memória do CRM)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anthropic (Cérebro da Nina - Claude Haiku 3.5 / 4.5)
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-3-5-haiku-latest

# WhatsApp (Meta Cloud API Oficial)
META_WHATSAPP_TOKEN=your-meta-access-token
META_PHONE_NUMBER_ID=your-phone-number-id
META_VERIFY_TOKEN=your-webhook-verification-token
# App Secret da Meta para validação de assinatura HMAC SHA-256 (Opcional, recomendado em prod)
META_APP_SECRET=your-meta-app-secret

# ElevenLabs (Síntese de Voz - Opcional)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# E-mail e SMS (Opcional)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Nina | SDR <nina@empresa.com.br>"
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Regras de Negócio (Minutos e Horas)
FORM_ABANDONMENT_MINUTES=15
SILENCE_RADAR_HOURS=6
